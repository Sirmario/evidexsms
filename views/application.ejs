<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("partials/head")%>
  </head>

  <body>
    <%-include("partials/header")%>

    <main class="page-shell">
      <section class="panel">
        <p class="kicker">Admissions</p>
        <h1 class="page-heading">
          <%= isApplicationActive ? "Application is now open" : "Application is closed" %>
        </h1>
        <p>
          <%= isApplicationActive
            ? "Complete your application below to begin the admissions process."
            : "The intake window is currently closed. Please check back later for the next cohort." %>
        </p>
      </section>

      <% if(isApplicationActive){%>
      <section class="auth-layout" style="margin-top: 1.5rem;">
        <div class="auth-card">
          <form action="/application" method="post" class="Application_Form">
            <div class="form-grid">
              <div class="form-field">
                <label for="firstname">Firstname</label>
                <input type="text" placeholder="Firstname" name="firstname" id="firstname" />
              </div>

              <div class="form-field">
                <label for="lastname">Lastname</label>
                <input type="text" placeholder="Lastname" name="lastname" id="lastname" />
              </div>
            </div>

            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" placeholder="Email" name="email" id="email" />
            </div>

            <div class="form-field">
              <label for="address">Address</label>
              <input type="text" placeholder="Address" name="address" id="address" />
            </div>

            <button type="submit">Submit Application</button>
          </form>
        </div>

        <div class="auth-card">
          <div class="form-meta">
            <h2>What happens next?</h2>
            <p>
              After you submit your application, our team will review it and
              update your status as soon as a decision is available.
            </p>
            <p>
              You can also monitor your progress by checking your application
              number anytime from the status page.
            </p>
            <a class="inline-link" href="/check-application">Check application status</a>
          </div>
        </div>
      </section>
      <%}%>
    </main>

    <%-include("partials/footer")%>
  </body>
</html>
