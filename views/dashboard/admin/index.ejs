<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("partials/head")%>
  </head>
  <body>
    <%-include("partials/header")%>

    <main class="page-shell">
      <section class="panel">
        <p class="kicker">Admin dashboard</p>
        <h1 class="page-heading">Welcome back, administrator.</h1>
        <p>
          Review new applications, manage user records, and keep your admissions
          workflow running smoothly.
        </p>
      </section>

      <section class="stat-grid">
        <article class="stat-card">
          <h2>Pending</h2>
          <p>Applications awaiting review.</p>
        </article>
        <article class="stat-card">
          <h2>Approved</h2>
          <p>Applicants confirmed for admission.</p>
        </article>
        <article class="stat-card">
          <h2>Users</h2>
          <p>Active students and system accounts.</p>
        </article>
      </section>
    </main>

    <%-include("partials/footer")%>
  </body>
</html>
