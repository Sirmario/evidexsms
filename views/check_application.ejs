<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("partials/head")%>
  </head>

  <body>
    <%-include("partials/header")%>

    <main class="page-shell">
      <section class="panel search-panel">
        <p class="kicker">Check status</p>
        <h1 class="page-heading">Track your admission status.</h1>
        <form id="form" class="search-form">
          <input
            type="text"
            placeholder="Enter application number"
            name="applicationNo"
            aria-label="Application number"
          />
          <button type="submit">Check Status</button>
        </form>
        <p class="search-summary">
          Use the application number sent to you during registration to review
          your admission result.
        </p>
      </section>
    </main>

    <%-include("partials/footer")%>
    <script>
      let formEl = document.getElementById("form");
      formEl.addEventListener("submit", (e) => {
        e.preventDefault();
        let appNo = Object.fromEntries(new FormData(e.target));
        checkApplication(appNo);
      });
      async function checkApplication(appNo) {
        try {
          let res = await fetch("/check-application", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(appNo),
          });
          let data = await res.json();
          createUI(data);
        } catch (err) {
          console.log(err);
        }
      }
      function createUI(data) {
        if (data.status == "approved")
          return (window.location.href = `/application_notification/${data.appNo}`);
        alert(data.message);
      }
    </script>
  </body>
</html>
