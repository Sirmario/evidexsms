<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("partials/head")%>
  </head>
  <body>
    <%-include("partials/header")%>

    <main class="page-shell">
      <section class="panel">
        <p class="kicker">About us</p>
        <h1 class="page-heading">A school system built for growth.</h1>
        <p>
          EVIDEX SMS was created to simplify how students apply, verify their
          details, and stay informed about their academic future. Our mission is
          to provide a modern, efficient experience for applicants and staff alike.
        </p>
      </section>

      <section class="content-grid">
        <div class="panel">
          <h2>Our vision</h2>
          <p>
            We believe transparent processes and digital-first systems create a
            stronger educational experience for everyone. By combining clear
            communication with easy-to-use workflows, we help students focus on
            what matters most: learning and opportunity.
          </p>
        </div>

        <div class="panel">
          <h2>What we do</h2>
          <ul class="feature-list">
            <li>Manage student applications smoothly</li>
            <li>Support academic onboarding and verification</li>
            <li>Track admissions status in real time</li>
            <li>Provide a clean experience for administration</li>
          </ul>
        </div>
      </section>
    </main>

    <%-include("partials/footer")%>
  </body>
</html>
